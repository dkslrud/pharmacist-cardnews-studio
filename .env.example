# 필수: Claude API 키
ANTHROPIC_API_KEY=
# 선택: 사용할 모델 (기본 claude-sonnet-5-5)
CLAUDE_MODEL=
# 선택: 접속 비밀번호 (비우면 누구나 사용)
APP_PASSWORD=
# 선택: 인스타그램 게시물 주소에서 이미지 자동 수집 (Apify)
APIFY_TOKEN=
APIFY_ACTOR=
# 선택: Canva 연동 (Canva 개발자 포털에서 만든 통합 앱 정보). 비우면 지시문 복사 방식만 보여요.
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
# 선택: 리디렉션 주소를 직접 지정할 때만 (기본: 접속 주소 + /api/canva/callback)
CANVA_REDIRECT_URI=

# ---- 업무 대시보드 (/dashboard) ----
# 노션 연동: notion.so/my-integrations 에서 만든 통합의 토큰. '프리랜서 업무 허브' 페이지에 통합을 연결(…→연결)해야 해요.
NOTION_TOKEN=
# 선택: 노션 DB ID를 바꿀 때만 (기본: 허브의 ✅ 할 일 / 📦 공동구매 일정)
NOTION_TASKS_DB=
NOTION_GROUPBUY_DB=
# 선택: 오늘의 업무 페이지를 쌓을 노션 페이지 ID (기본: 허브 아래 '📋 일일 업무 브리핑' 자동 생성)
NOTION_BRIEF_PARENT_ID=
# 구글 캘린더 연동 (Google Cloud OAuth 클라이언트 + calendar.readonly 권한의 refresh token)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# 선택: 여러 캘린더를 볼 때 쉼표로 (기본 primary)
GOOGLE_CALENDAR_IDS=
# 매일 오전 9시 오늘의 업무 작성 (GPT)
OPENAI_API_KEY=
OPENAI_MODEL=
# Vercel Cron 호출 인증용 임의의 긴 문자열 (필수)
CRON_SECRET=
